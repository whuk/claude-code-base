{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebSearch",
      "WebFetch"
    ]
  },
  "language": "korean",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; [ -f \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-command-shell.py\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-command-shell.py\" --hook",
            "statusMessage": "커맨드 문서 셸 상태 검사"
          }
        ]
      }
    ]
  }
}
